# Local development: npm run db:local:start generates actual private URLs
# in .env.development.local, overriding these examples. No Docker or Neon needed.
DATABASE_URL=postgresql://atlas_local:REPLACE_LOCAL_PASSWORD@127.0.0.1:5433/atlas_erp
DATABASE_URL_UNPOOLED=postgresql://atlas_local:REPLACE_LOCAL_PASSWORD@127.0.0.1:5433/atlas_erp
# Later Neon deployment: runtime uses its pooled URL (-pooler hostname),
# migrations use its direct URL; preserve provider SSL settings.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Use the exact deployment origin in Vercel, localhost only for npm run dev.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEMO_MODE=true
# These are intentionally PUBLIC demo credentials, not real-user secrets.
DEMO_PASSWORD=replace-with-a-public-demo-password-at-least-12-chars
NEXT_PUBLIC_DEMO_PASSWORD=replace-with-the-same-public-demo-password
