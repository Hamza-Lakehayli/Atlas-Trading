{
  "name": "atlas-erp-showcase",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:check": "tsx src/server/db/check.ts",
    "db:local:start": "tsx scripts/local-postgres.ts start",
    "db:local:stop": "tsx scripts/local-postgres.ts stop",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:seed": "tsx src/server/db/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "verify:foundations": "tsx scripts/verify-foundations.ts",
    "verify:orders": "tsx scripts/verify-order-workflow.ts",
    "verify:customers": "tsx scripts/verify-customers.ts",
    "verify:quotes": "tsx scripts/verify-quotes.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@vercel/functions": "3.6.1",
    "better-auth": "^1.7.14",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@faker-js/faker": "^10.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
